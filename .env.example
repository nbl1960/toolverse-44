# Required: your Google Gemini API key, used server-side only by every
# AI-powered tool and the AI Guide across the platform.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: your deployed site URL, used across the platform for SEO
# metadata (Open Graph, JSON-LD, sitemap.xml, robots.txt).
# Defaults to https://toolsverse.co if unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: a webhook URL the contact form POSTs to (a Resend/SendGrid
# function, a Slack incoming webhook, Zapier, etc.). Without this set,
# contact form submissions are still validated and logged server-side,
# but the form honestly falls back to opening the visitor's own email
# client instead of claiming a delivery that didn't happen.
# See ENVIRONMENT.md for the full explanation.
CONTACT_WEBHOOK_URL=

# Required: your Google Gemini API key, used server-side only by the
# AI-powered tools (Email Writer, the YouTube generator suite).
# As more AI-powered tools are added to the registry, they'll reuse this
# same key unless a tool specifically needs its own.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: your deployed site URL, used across the platform for SEO
# metadata (Open Graph, JSON-LD, sitemap.xml, robots.txt).
# Defaults to https://toolsverse.co if unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
